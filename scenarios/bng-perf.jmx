      <!-- Upload journey: 23 step(s) -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Upload journey normal @ 1 user(s)">
        <stringProp name="TestPlan.comments">The FULL upload journey at 1 concurrent user(s), normal file —
initiate, multipart POST to the CDP Uploader, then validate, as one closed
loop per user. Every iteration is a real new upload, so the uploader and
its scanner are inside the number.

No client-side poll: the backend&apos;s validate route waits for the scan
itself, so the validate leg carries the same wall clock a frontend user
experiences, without a polling loop&apos;s noise in the report.</stringProp>
        <stringProp name="ThreadGroup.num_threads">${__P(users_journey_normal_1,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(window_journey_normal_1,20)}</stringProp>
