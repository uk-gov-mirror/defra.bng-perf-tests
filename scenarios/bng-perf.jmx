      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Upload journey xlarge @ 2 user(s)">
        <stringProp name="TestPlan.comments">The FULL upload journey at 2 concurrent user(s), xlarge file —
