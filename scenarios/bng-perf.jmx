          </hashTree>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Project creation (typical baseline)">
        <stringProp name="TestPlan.comments">Write-path load on POST /projects/new at a REALISTIC baseline size.

Scheduled into the EVERYDAY phase (0-everydayPhaseDurationSeconds) alongside the
home-page and project-list groups, deliberately NOT into the quiet stretch the
upload phases are read against.

Every create is permanent: the row lands in bng.projects and the write_audit_log
trigger copies the whole document into bng.audit_log, which is append-only
(backend changelog/db.changelog-1.9.xml) and cannot be cleared down. Keep
createParcels small — it is the dominant lever on bytes written per run.
Set createThreads=0 to disable the group entirely.</stringProp>
        <stringProp name="ThreadGroup.num_threads">${__P(createThreads,5)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(createRampSeconds,5)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(everydayPhaseDurationSeconds,25)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${__P(createLoops,10)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
          <stringProp name="HTTPSampler.domain">${__P(backendDomain,bng-metric-backend.${__P(env)}.cdp-int.defra.cloud)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(protocol,https)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(backendPort,${__P(port,443)})}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </ConfigTestElement>
        <hashTree/>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Auth + JSON headers">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${bearerToken}</stringProp>
            </elementProp>
            <elementProp name="" elementType="Header">
