        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="create a worst-case ~800 KB project (POST /projects/new)">
          <stringProp name="TestPlan.comments">Worst-case create: createLargeParcels (default 3900) keeps the body just under Hapi&apos;s 1 MB cap.</stringProp>
          <stringProp name="HTTPSampler.path">/projects/new</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${createBody}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build project body">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Build one POST /projects/new body with `parcels` baseline habitats.
// Keys mirror scripts/seed-via-api.mjs exactly: the backend&apos;s habitatSchema
// rejects unknown keys, so every key here must be one it recognises.
// Written with .times{} / .append() so this script contains no XML-special
// characters and needs no escaping inside the .jmx.
def parcels = (vars.get(&apos;createLargeParcels&apos;) ?: &apos;25&apos;) as int
def sb = new StringBuilder(parcels * 210 + 128)
sb.append(&apos;{&quot;project&quot;:{&quot;name&quot;:&quot;perf-create &apos;)
  .append(UUID.randomUUID().toString())
  .append(&apos;&quot;,&quot;baseline&quot;:{&quot;habitats&quot;:[&apos;)
parcels.times { i -&gt;
  if (i) { sb.append(&apos;,&apos;) }
  sb.append(&apos;{&quot;featureId&quot;:&quot;&apos;).append(UUID.randomUUID().toString())
    .append(&apos;&quot;,&quot;ref&quot;:&quot;perf-&apos;).append(i)
    .append(&apos;&quot;,&quot;type&quot;:&quot;Mixed scrub&quot;,&quot;broadType&quot;:&quot;Heathland and shrub&quot;,&quot;distinctiveness&quot;:&quot;Medium&quot;,&quot;condition&quot;:&quot;Moderate&quot;,&quot;area&quot;:5000,&quot;status&quot;:&quot;Complete&quot;}&apos;)
}
sb.append(&apos;]}}}&apos;)
vars.put(&apos;createBody&apos;, sb.toString())</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status 200">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
