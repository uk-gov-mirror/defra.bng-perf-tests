      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Everyday user (background probe)">
        <stringProp name="ThreadGroup.num_threads">${__P(probeThreads,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
